s","tags":[],"type":"text","url":"/tonconsole/invoices#step-4-register-your-application","content":"> **Note:** The recipient wallet must have at least one outgoing transaction on the TON blockchain to be eligible."},"998":{"id":"/tonconsole/invoices-30","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-4-register-your-application","content":"If the wallet is new, **activate it by sending a small amount (e.g., `0.01 GRAM`) *from this wallet to any other address***."},"999":{"id":"/tonconsole/invoices-31","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#managing-applications","content":"Once access is granted:"},"1000":{"id":"/tonconsole/invoices-32","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#managing-applications","content":"An `API token` will be created automatically."},"1001":{"id":"/tonconsole/invoices-33","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#managing-applications","content":"Use the TON Console for UI or API to manage invoices (create, delete, view)."},"1002":{"id":"/tonconsole/invoices-34","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#managing-applications","content":"Register a webhook on the Overview page to handle invoice status changes."},"1003":{"id":"/tonconsole/invoices-35","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-1-user-initiates-payment","content":"A user starts the payment process on your website. The frontend sends a request to your backend to create an invoice."},"1004":{"id":"/tonconsole/invoices-36","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-2-create-an-invoice","content":"Your backend makes an API request to Tonconsole using the API token."},"1005":{"id":"/tonconsole/invoices-37","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-2-create-an-invoice","content":"**Parameters:**"},"1006":{"id":"/tonconsole/invoices-38","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-2-create-an-invoice","content":"`amount`: Amount in minimal indivisible units (1/1000000000 for GRAM and 1/1000000 for USDT)."},"1007":{"id":"/tonconsole/invoices-39","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-2-create-an-invoice","content":"`life_time`: Invoice lifetime in seconds."},"1008":{"id":"/tonconsole/invoices-40","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-2-create-an-invoice","content":"`currency`: Currency code (GRAM or USDT)."},"1009":{"id":"/tonconsole/invoices-41","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-2-create-an-invoice","content":"`description` (optional): Service-specific description visible only to you in the Tonconsole interface."},"1010":{"id":"/tonconsole/invoices-42","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-3-handle-api-response","content":"Tonconsole returns a response with the invoice details, including a `payment_link`. Send this link to your frontend, where it can be used in a \"Pay with Keeper\" button or as a QR code."},"1011":{"id":"/tonconsole/invoices-43","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-3-handle-api-response","content":"**Response Example:**"},"1012":{"id":"/tonconsole/invoices-44","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#step-4-monitor-invoice-status","content":"Register a webhook to receive updates about invoice status changes. Tonconsole will send a POST request to your webhook whenever the status updates (e.g., from \"pending\" to \"paid\"). This ensures real-time tracking of payments."},"1013":{"id":"/tonconsole/invoices-45","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#webhook-for-updates","content":"Use a webhook to monitor changes in invoice status. A webhook is a mechanism where Tonconsole sends a POST request to your server whenever an invoice status changes (e.g., from \"pending\" to \"paid\")."},"1014":{"id":"/tonconsole/invoices-46","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#webhook-for-updates","content":"Here’s how you can handle webhooks on your server:"},"1015":{"id":"/tonconsole/invoices-47","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#webhook-payload","content":"**Payload type**"},"1016":{"id":"/tonconsole/invoices-48","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#webhook-payload","content":"**Payload example**"},"1017":{"id":"/tonconsole/invoices-49","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#explanation","content":"**`/tonconsole-webhooks`:** Replace this path with your desired endpoint URL."},"1018":{"id":"/tonconsole/invoices-50","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#explanation","content":"**Webhook Payload:** This is the structure of the data Tonconsole will send to your endpoint whenever an invoice's status changes."},"1019":{"id":"/tonconsole/invoices-51","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#explanation","content":"**Logging and Acknowledgement:** Always log the payload and respond with a `200` status to indicate successful receipt."},"1020":{"id":"/tonconsole/invoices-52","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#explanation","content":"Here is an example of how this can be implemented on your side."},"1021":{"id":"/tonconsole/invoices-53","page_id":"/tonconsole/invoices","tags":[],"type":"text","url":"/tonconsole/invoices#fetching-invoice-by-id","co