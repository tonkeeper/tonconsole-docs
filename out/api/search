i/dapp/free-limits-6","page_id":"/tonapi/dapp/free-limits","type":"heading","tags":[],"url":"/tonapi/dapp/free-limits#summary","content":"Summary"},"364":{"id":"/tonapi/dapp/free-limits-7","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#overview","content":"TONAPI is already available for free, but with a default rate limit of **1 request per second (1 RPS)**. If your dApp requires higher limits, you can take advantage of Keeper's built-in mechanism to gain additional API capacity at no extra cost."},"365":{"id":"/tonapi/dapp/free-limits-8","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#overview","content":"Keeper introduces a way for dApps to access high TONAPI limits for free. This feature allows dApps running in the **Keeper browser** or in **any browser with the Keeper extension installed** to leverage a built-in proxy mechanism that optimizes API requests."},"366":{"id":"/tonapi/dapp/free-limits-9","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#how-it-works","content":"When a dApp is opened inside the Keeper browser or a browser with the Keeper extension, the global `window.tonapi` object becomes available. If the dApp is using @ton-api/client, it will automatically leverage this object. `window.tonapi` provides a custom `fetch` implementation that routes requests through Keeper's internal proxy, sending them on behalf of Keeper's TONAPI provider."},"367":{"id":"/tonapi/dapp/free-limits-10","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#key-benefits","content":"**Higher rate limits:** Requests made via `window.tonapi.fetch` are processed with higher TONAPI limits."},"368":{"id":"/tonapi/dapp/free-limits-11","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#key-benefits","content":"**No extra setup:** The dApp does not need to modify API calls—just use `@ton-api/client` as usual."},"369":{"id":"/tonapi/dapp/free-limits-12","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#key-benefits","content":"**Works in the Keeper browser and in any browser with the Keeper extension installed.**"},"370":{"id":"/tonapi/dapp/free-limits-13","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#1-ensuring-proper-api-key-usage","content":"Even when using `window.tonapi.fetch`, you **must provide a valid TONAPI key** when initializing `@ton-api/client`. The key can be a free-tier key, but it must be valid."},"371":{"id":"/tonapi/dapp/free-limits-14","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#1-ensuring-proper-api-key-usage","content":"If `window.tonapi` is available, `@ton-api/client` will automatically use `window.tonapi.fetch` for making requests."},"372":{"id":"/tonapi/dapp/free-limits-15","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#2-restricting-your-dapp-to-free-high-limit","content":"If you want to ensure that your dApp only functions in environments where `window.tonapi` is available , you can enforce this restriction:"},"373":{"id":"/tonapi/dapp/free-limits-16","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#summary","content":"`window.tonapi.fetch` allows dApps running in the Keeper browser or a browser with the Keeper extension to use high TONAPI limits."},"374":{"id":"/tonapi/dapp/free-limits-17","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#summary","content":"You must provide a valid TONAPI key when initializing `@ton-api/client`."},"375":{"id":"/tonapi/dapp/free-limits-18","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#summary","content":"You can restrict your dApp to work only when `window.tonapi` is available if you need high RPS."},"376":{"id":"/tonapi/dapp/free-limits-19","page_id":"/tonapi/dapp/free-limits","tags":[],"type":"text","url":"/tonapi/dapp/free-limits#summary","content":"For more details about methods, go to REST API section."},"377":{"id":"/tonapi/dapp","page_id":"/tonapi/dapp","type":"page","content":"dApp","breadcrumbs":["Tonconsole","Ton API","dApp"],"tags":[],"url":"/tonapi/dapp"},"378":{"id":"/tonapi/dapp-0","page_id":"/tonapi/dapp","type":"heading","tags":[],"url":"/tonapi/dapp#guides","content":"Guides"},"379":{"id":"/tonapi/dapp-1","page_id":"/tonapi/dapp","tags":[],"type":"text","url":"/tonapi/dapp","content":"This section provides resources for building dApps with **TONAPI**, enabling seamless interaction with the TON blockchain."},"380":{"id":"/tonapi/dapp-2","page_id":"/tonapi/dapp","tags":[],"type":"text","url":"/tonapi/dapp#guides","content":"Building a TON dApp – Learn how to develop a dApp using TONAPI."},"381":{"id":"/tonapi/dapp-3","page_id":"/tonapi/dapp","tags":[],"type":"text","url":"/tonapi/dapp#guides","content":"Free TONAPI limits – Get higher API limits for free in your dApps."},"382":{"id":"/tonapi/graphql","page_id":"/tonapi/graphql","type":"page","content":"GraphQL API Documentation","tags":[],"url":"/tonapi/graphql"},"383":{"id":"/tonapi/graphql-0","page_id":"/tonapi/graphql","type":"heading","tags":[],"url":"/tonapi/graphql#graphql-playground","content":"GraphQL Playground"},"384":{"id":"/tonapi/graphql-1","page_id":"/tonapi/graphql","type":"heading","tags":[],"url":"/tonapi/graphql#fetching-data-with-nodejs","content":"Fetching data with Node.js"},"385":{"id":"/tonapi/graphql-2","page_id":"/tonapi/graphql","type":"heading","tags":[],"url":"/tonapi/graphql#fetching-data-with-graphql-request-library","content":"Fetching data with graphql-request library"},"386":{"id":"/tonapi/graphql-3","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql","content":"GraphQL API may work unstably and is expected to be redesigned. It is recommended to use REST API for more reliable operation."},"387":{"id":"/tonapi/graphql-4","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql","content":"Our GraphQL service is conveniently accessible via the API endpoint found at https://tonapi.io/v2/graphql. You can perform various queris and mutations utilizing this tier."},"388":{"id":"/tonapi/graphql-5","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#graphql-playground","content":"For a better interactive experience, we have made the GraphQL Playground available for you. Feel free to use this feature at the endpoint https://tonapi.io/v2/graphql/playground to test your queries, mutations and perform real-time queries alongside a schema documentation view."},"389":{"id":"/tonapi/graphql-6","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-nodejs","content":"Here's an example of how to interact with the given endpoint in a Node.js environment to specifically fetch data for one account:"},"390":{"id":"/tonapi/graphql-7","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-nodejs","content":"In this example, we're using the axios library to send a POST request to the specified endpoint."},"391":{"id":"/tonapi/graphql-8","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-nodejs","content":"We're requesting the first account using the allAccounts(first: 1) query. This returns only the first account from the list."},"392":{"id":"/tonapi/graphql-9","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-nodejs","content":"The fields included in the nodes are arbitrary and you should replace id and name with actual fields from the API."},"393":{"id":"/tonapi/graphql-10","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-nodejs","content":"Remember to install the axios package in your Node.js environment using npm:"},"394":{"id":"/tonapi/graphql-11","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-graphql-request-library","content":"In this example, we're using the request method from the graphql-request library to send a request to the mentioned endpoint."},"395":{"id":"/tonapi/graphql-12","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-graphql-request-library","content":"We're requesting for the first account from allAccounts(first: 1). This will return only the first account from the list."},"396":{"id":"/tonapi/graphql-13","page_id":"/tonapi/graphql","tags":[],"type":"text","url":"/tonapi/graphql#fetching-data-with-graphql-request-library","content":"Note that the fields inside nodes are just placeholders and you should replace id and name with the actual fields as per your API."},"397":{"id":"/tonapi","page_id":"/tonapi","type":"page","content":"About","breadcrumbs":["Tonconsole","Ton API"],"tags":[],"url":"/tonapi"},"398":{"id":"/tonapi-0","page_id":"/tonapi","type":"heading","tags":[],"url":"/tonapi#authorization","content":"Authorization"},"399":{"id":"/tonapi-1","page_id":"/tonapi","type":"heading","tags":[],"url":"/tonapi#limits","content":"Limits"},"400":{"id":"/tonapi-2","page_id":"/tonapi","type":"heading","tags":[],"url":"/tonapi#launch-you-own-tonapi-node","content":"launch you own TonAPI node"},"401":{"id":"/tonapi-3","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi","content":"This API is designed to provide users with a simple and streamlined experience, eliminating the complexity of the TON blockchain. For instance, you don't need to worry about supporting all wallet standards, performing verifications, or decoding raw bits and bytes. We aim to streamline the process for you, so you can focus on utilizing the functionality of the API without getting bogged down by technical details."},"402":{"id":"/tonapi-4","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi","content":"To prevent confusion, some data is hidden. However, if you require raw blockchain data, you can use our http-to-adnl proxy methods to fetch raw data from a light server."},"403":{"id":"/tonapi-5","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#authorization","content":"All methods are available without authentication, but with a rate limit of 1 request per 4 seconds (0.24 rps)."},"404":{"id":"/tonapi-6","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#authorization","content":"To authorize your request, you will need a token, which you can obtain from https://tonconsole.com/. Here is an example of a token: `AGZVOXZ3SLHOAA4TRVL4DWQ5DUZK25MSEIGXAFHZ43TMPGXQ6NZZXEWROYSJHCONGSFITLI`."},"405":{"id":"/tonapi-7","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#authorization","content":"To pass the token in your request, please add the Authorization HTTP header with the \"Bearer scheme.\" Here is an example:"},"406":{"id":"/tonapi-8","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#limits","content":"The rate limits for all of your issued tokens are the same and match the plan you have. The rate limits are the same for both the testnet and mainnet (if you're paying for a 10 rps plan, you'll get 10 rps in the testnet and 10 rps in the mainnet)."},"407":{"id":"/tonapi-9","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#limits","content":"Learn more about tiers and limit on TonConsole"},"408":{"id":"/tonapi-10","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#launch-you-own-tonapi-node","content":"There is a separate limited open-source version of TonAPI available at https://github.com/tonkeeper/opentonapi. This version does not require a full blockchain index."},"409":{"id":"/tonapi-11","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#launch-you-own-tonapi-node","content":"Some data that requires full node sync, such as (jettons, NFTs, and full account information), may not be visible through this version of TonAPI, but all of the basic functionality is in place."},"410":{"id":"/tonapi-12","page_id":"/tonapi","tags":[],"type":"text","url":"/tonapi#launch-you-own-tonapi-node","content":"Opentonapi can also work on private light server nodes as well as public ones."},"411":{"id":"/tonapi/liteservers","page_id":"/tonapi/liteservers","type":"page","content":"Liteservers","breadcrumbs":["Tonconsole","Ton API"],"tags":[],"url":"/tonapi/liteservers"},"412":{"id":"/tonapi/liteservers-0","page_id":"/tonapi/liteservers","type":"heading","tags":[],"url":"/tonapi/liteservers#advantages-of-this-service-over-deploying-your-own-node","content":"Advantages of this service over deploying your own node"},"413":{"id":"/tonapi/liteservers-1","page_id":"/tonapi/liteservers","type":"heading","tags":[],"url":"/tonapi/liteservers#connecting-to-the-liteserver","content":"Connecting to the Liteserver"},"414":{"id":"/tonapi/liteservers-2","page_id":"/tonapi/liteservers","type":"heading","tags":[],"url":"/tonapi/liteservers#rate-limits","content":"Rate limits"},"415":{"id":"/tonapi/liteservers-3","page_id":"/tonapi/liteservers","type":"heading","tags":[],"url":"/tonapi/liteservers#error-codes","content":"Error codes"},"416":{"id":"/tonapi/liteservers-4","page_id":"/tonapi/liteservers","type":"heading","tags":[],"url":"/tonapi/liteservers#archive-node-access","content":"Archive node access"},"417":{"id":"/tonapi/liteservers-5","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers","content":"The service provides access to a `Lite API` for interaction with a liteserver node."},"418":{"id":"/tonapi/liteservers-6","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers","content":"This API is used in applications that require access to low-level blockchain data (transactions, account states, etc.) and \nguarantees the reliability of this data (proof verification).\nFor example: blockchain indexers, payment processors, SDK, etc."},"419":{"id":"/tonapi/liteservers-7","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers","content":"A more detailed description of this protocol can be found here.\nThe set of methods provided by the API is described here."},"420":{"id":"/tonapi/liteservers-8","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#advantages-of-this-service-over-deploying-your-own-node","content":"It eliminates the need for complex maintenance and updates of the node (especially demanding and costly in the case of an archival node)"},"421":{"id":"/tonapi/liteservers-9","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#advantages-of-this-service-over-deploying-your-own-node","content":"It reduces the risk of out of sync error"},"422":{"id":"/tonapi/liteservers-10","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#advantages-of-this-service-over-deploying-your-own-node","content":"It provides access to historical data"},"423":{"id":"/tonapi/liteservers-11","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#advantages-of-this-service-over-deploying-your-own-node","content":"It offers high availability"},"424":{"id":"/tonapi/liteservers-12","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#connecting-to-the-liteserver","content":"To connect to the Liteserver, you need to use an application or libraries with a Liteclient function.\nYou need to specify the `Server` and `Public key` or download the `global.config.json` file with the ready-made configuration for connection."},"425":{"id":"/tonapi/liteservers-13","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#connecting-to-the-liteserver","content":"You can obtain this data in Tonconsole after selecting a plan."},"426":{"id":"/tonapi/liteservers-14","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#connecting-to-the-liteserver","content":"Access to two instances of Liteservers (`Server #1` and `Server #2`) is provided, \nand it is better to specify both for higher fault tolerance (if your software supports it)."},"427":{"id":"/tonapi/liteservers-15","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#rate-limits","content":"Each plan has its rate limits, which operate on a sliding window algorithm. \nThe window size is 10 seconds. Therefore, with a rate limit of 1 RPS, the maximum number of requests is 10 requests per 10-second period."},"428":{"id":"/tonapi/liteservers-16","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#rate-limits","content":"The maximum RPS for current plans is 50. Contact support for the custom plan."},"429":{"id":"/tonapi/liteservers-17","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#rate-limits","content":"To obtain rate limit data, the service provides an API method:"},"430":{"id":"/tonapi/liteservers-18","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#rate-limits","content":"Where: `rate limit = limit / per_time[s]`"},"431":{"id":"/tonapi/liteservers-19","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#error-codes","content":"In addition to the standard liteserver error codes (such as 651, -400, etc.), there are two additional error codes:"},"432":{"id":"/tonapi/liteservers-20","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#error-codes","content":"228 - rate limit exceeded (there used to be code 5556, but it was replaced with 228 for unification)"},"433":{"id":"/tonapi/liteservers-21","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#error-codes","content":"5555 - internal server error"},"434":{"id":"/tonapi/liteservers-22","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#error-codes","content":"It is important to correctly handle these error codes to ensure stable operation of the client application.\nTo avoid the rate limit error, a rate limiter can be used on the client side and set to a value slightly below the maximum value of the plan.\nFor error 5555, it is usually enough to retry the request."},"435":{"id":"/tonapi/liteservers-23","page_id":"/tonapi/liteservers","tags":[],"type":"text","url":"/tonapi/liteservers#archive-node-access","content":"By default, the service provides access to an archival node for obtaining historical data (i.e., data from the first blocks of the blockchain)."},"436":{"id":"/tonapi/recipes","page_id":"/tonapi/recipes","type":"page","content":"This page was moved","tags":[],"url":"/tonapi/recipes"},"437":{"id":"/tonapi/recipes-0","page_id":"/tonapi/recipes","tags":[],"type":"text","url":"/tonapi/recipes","content":"Please visit the Cookbook section for the latest documentation"},"438":{"id":"/tonapi/rest-api/accounts","page_id":"/tonapi/rest-api/accounts","type":"page","content":"Accounts","breadcrumbs":["Tonconsole","Ton API","REST API"],"tags":[],"url":"/tonapi/rest-api/accounts"},"439":{"id":"/tonapi/rest-api/accounts-0","page_id":"/tonapi/rest-api/accounts","type":"heading","tags":[],"url":"/tonapi/rest-api/accounts#operations","content":"Operations"},"440":{"id":"/tonapi/rest-api/accounts-1","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts","content":"Open in Swagger UI"},"441":{"id":"/tonapi/rest-api/accounts-2","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts","content":"**Accounts** service provide API access to structured account information within the TON network. Allows retrieval of data such as balance, transaction history, DNS, multisigs, NFTs, Jettons, and other account-related details without dealing with low-level specifics. All data is regularly updated and can be used to build applications that require accurate and up-to-date account information."},"442":{"id":"/tonapi/rest-api/accounts-3","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccounts` — Get human-friendly information about several accounts without low-level details."},"443":{"id":"/tonapi/rest-api/accounts-4","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`searchAccounts` — Search by account domain name"},"444":{"id":"/tonapi/rest-api/accounts-5","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccount` — Get human-friendly information about an account without low-level details."},"445":{"id":"/tonapi/rest-api/accounts-6","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountDefiAssets` — Return DeFi assets locked in custom smart contracts: currently returns TON Whales staking and EVAA lending positions."},"446":{"id":"/tonapi/rest-api/accounts-7","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountDiff` — Get account's balance change"},"447":{"id":"/tonapi/rest-api/accounts-8","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`accountDnsBackResolve` — Get account's domains"},"448":{"id":"/tonapi/rest-api/accounts-9","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountDnsExpiring` — Get expiring account .ton dns"},"449":{"id":"/tonapi/rest-api/accounts-10","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountEvents` — Get events for an account. Each event is built on top of a trace which is a series of transactions caused by one inbound message. TonAPI looks for known patterns inside the trace and splits the trace into actions, where a single action represents a meaningful high-level operation like a Jetton Transfer or an NFT Purchase. Actions are expected to be shown to users. It is advised not to build any logic on top of actions because actions can be changed at any time."},"450":{"id":"/tonapi/rest-api/accounts-11","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountEvent` — Get event for an account by event_id"},"451":{"id":"/tonapi/rest-api/accounts-12","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountExtraCurrencyHistoryByID` — Get the transfer history of extra currencies for an account."},"452":{"id":"/tonapi/rest-api/accounts-13","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountJettonsBalances` — Get all Jettons balances by owner address"},"453":{"id":"/tonapi/rest-api/accounts-14","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountJettonsHistory` — Get the transfer jettons history for account"},"454":{"id":"/tonapi/rest-api/accounts-15","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountJettonBalance` — Get Jetton balance by owner address"},"455":{"id":"/tonapi/rest-api/accounts-16","page_id":"/tonapi/rest-api/accounts","tags":[],"type":"text","url":"/tonapi/rest-api/accounts#operations","content":"`getAccountJettonHistoryByID` — Please use `getJettonAccountHistoryByID`` instead"},"456":{"id":"/tonapi/rest-api/accounts-17","page_id":"/tonapi/rest-api/accounts","tags":[],"