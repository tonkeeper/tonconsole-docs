ew-contract-deployments","content":"Subscribe to events about new contract deployments"},"797":{"id":"/tonapi/webhooks-api-19","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#unsubscribe-from-events-about-new-contract-deployments","content":"Unsubscribe from events about new contract deployments"},"798":{"id":"/tonapi/webhooks-api-20","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#subscribe-to-messages-with-a-specific-opcode-in-a-message-body","content":"Subscribe to messages with a specific opcode in a message body"},"799":{"id":"/tonapi/webhooks-api-21","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#unsubscribe-from-messages-with-a-specific-opcode-in-a-message-body","content":"Unsubscribe from messages with a specific opcode in a message body"},"800":{"id":"/tonapi/webhooks-api-22","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#get-a-webhooks-opcode-subscriptions","content":"Get a webhook's opcode subscriptions"},"801":{"id":"/tonapi/webhooks-api-23","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#subscribe-to-mempool-events","content":"Subscribe to mempool events"},"802":{"id":"/tonapi/webhooks-api-24","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#unsubscribe-from-mempool-events","content":"Unsubscribe from mempool events"},"803":{"id":"/tonapi/webhooks-api-25","page_id":"/tonapi/webhooks-api","type":"heading","tags":[],"url":"/tonapi/webhooks-api#testnet-webhooks","content":"Testnet webhooks"},"804":{"id":"/tonapi/webhooks-api-26","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api","content":"Webhooks API provides a way to subscribe to events that happen in the TON blockchain.\nThis allows you to build applications that react to events in the blockchain."},"805":{"id":"/tonapi/webhooks-api-27","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#authentication","content":"All methods of Webhooks API require a private API key.\nYou can get a personal API key at https://tonconsole.com/."},"806":{"id":"/tonapi/webhooks-api-28","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#authentication","content":"Webhooks API looks for an API key in two places in the following order:"},"807":{"id":"/tonapi/webhooks-api-29","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#authentication","content":"In the \"token\" parameter of the query string.\nFor example:"},"808":{"id":"/tonapi/webhooks-api-30","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#authentication","content":"In the Authorization header with the \"Bearer scheme\".\nFor example:"},"809":{"id":"/tonapi/webhooks-api-31","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#webhook-delivery","content":"When an event happens, TONAPI sends a POST request to a webhook URL with the following headers:"},"810":{"id":"/tonapi/webhooks-api-32","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#webhook-delivery","content":"`Authorization` carries the webhook's secret token, returned on creation and by the list method.\nCheck it to make sure a request comes from TONAPI."},"811":{"id":"/tonapi/webhooks-api-33","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#webhook-delivery","content":"`Idempotency-Key` is the same for every delivery attempt of the same event, use it to deduplicate retries."},"812":{"id":"/tonapi/webhooks-api-34","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#webhook-delivery","content":"A delivery is successful when the endpoint responds with a 2xx status code.\nOtherwise the webhook becomes `offline` and TONAPI keeps retrying with growing intervals:\nevery minute for the first 10 attempts, every 5 minutes up to 20 attempts, every 10 minutes up to 30 attempts and every hour after that.\nRetries stop after a week of failures. Use Mark a webhook back online to resume deliveries immediately."},"813":{"id":"/tonapi/webhooks-api-35","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#account-transaction-event","content":"An example of a request body:"},"814":{"id":"/tonapi/webhooks-api-36","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#account-transaction-event","content":"If a webhook is created with `add_transaction_info` or `add_account_info`, the body additionally contains:"},"815":{"id":"/tonapi/webhooks-api-37","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#account-transaction-event","content":"`transaction` - the transaction in the TONAPI Transaction schema;"},"816":{"id":"/tonapi/webhooks-api-38","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#account-transaction-event","content":"`account` - the account in the TONAPI Account schema.\n`balance`, `status` and `last_activity` are as of right after the transaction,\n`extra_balance`, `interfaces` and `get_methods` are as of the delivery."},"817":{"id":"/tonapi/webhooks-api-39","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#account-transaction-event","content":"The `Idempotency-Key` is computed over the short body (without `transaction` and `account`)."},"818":{"id":"/tonapi/webhooks-api-40","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#new-contract-and-message-opcode-events","content":"An example of a request body:"},"819":{"id":"/tonapi/webhooks-api-41","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#mempool-event","content":"An example of a request body:"},"820":{"id":"/tonapi/webhooks-api-42","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#create-webhook","content":"POST https://rt.tonapi.io/webhooks - the method creates a new webhook, configures its endpoint and returns a webhook ID and its secret token.\nA webhook ID is used to manage subscriptions."},"821":{"id":"/tonapi/webhooks-api-43","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#create-webhook","content":"A request body:"},"822":{"id":"/tonapi/webhooks-api-44","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#create-webhook","content":"`add_transaction_info` and `add_account_info` are optional, see Account transaction event."},"823":{"id":"/tonapi/webhooks-api-45","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#create-webhook","content":"The method is idempotent: if a webhook with the same endpoint already exists, its ID is returned.\nIf the existing webhook has different `add_transaction_info` or `add_account_info`, the method returns 409 Conflict,\nuse Update a webhook to change them."},"824":{"id":"/tonapi/webhooks-api-46","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#create-webhook","content":"A response example:"},"825":{"id":"/tonapi/webhooks-api-47","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#list-webhooks","content":"GET https://rt.tonapi.io/webhooks - the method returns all available webhooks.\nA response example:"},"826":{"id":"/tonapi/webhooks-api-48","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#list-webhooks","content":"`status` - `online`, `offline` (deliveries fail and are being retried) or `suspended` (deliveries are stopped, e.g. due to insufficient balance);"},"827":{"id":"/tonapi/webhooks-api-49","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#list-webhooks","content":"`status_updated_at` - when the status last changed, for an `offline` webhook this is when the endpoint broke;"},"828":{"id":"/tonapi/webhooks-api-50","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#list-webhooks","content":"`last_attempt_at` - when the last delivery was attempted, successful or not;"},"829":{"id":"/tonapi/webhooks-api-51","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#list-webhooks","content":"`status_failed_attempts` - the number of failed delivery attempts since the webhook went `offline`."},"830":{"id":"/tonapi/webhooks-api-52","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#update-a-webhook","content":"PATCH https://rt.tonapi.io/webhooks/{webhook_id} - the method changes a webhook's endpoint or options. At least one field is required."},"831":{"id":"/tonapi/webhooks-api-53","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#update-a-webhook","content":"A request body:"},"832":{"id":"/tonapi/webhooks-api-54","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#update-a-webhook","content":"The method returns 409 Conflict if another webhook already uses the endpoint."},"833":{"id":"/tonapi/webhooks-api-55","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#delete-a-webhook","content":"DELETE https://rt.tonapi.io/webhooks/{webhook_id} - the method deletes a webhook and all its subscriptions."},"834":{"id":"/tonapi/webhooks-api-56","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#generate-a-new-webhook-token","content":"POST https://rt.tonapi.io/webhooks/{webhook_id}/generate-new-token - the method rotates the webhook's secret token."},"835":{"id":"/tonapi/webhooks-api-57","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#generate-a-new-webhook-token","content":"A response example:"},"836":{"id":"/tonapi/webhooks-api-58","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#mark-a-webhook-back-online","content":"POST https://rt.tonapi.io/webhooks/{webhook_id}/back-online - the method marks a webhook as `online` and resumes deliveries without waiting for the next retry.\nFor a `suspended` webhook it returns 402 Payment Required if the project balance is not positive."},"837":{"id":"/tonapi/webhooks-api-59","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-webhook-logs","content":"GET https://rt.tonapi.io/webhooks/{webhook_id}/logs?offset=0 - the method returns failed delivery attempts and other webhook events.\nPass `next_offset` from the response as `offset` to get the next page."},"838":{"id":"/tonapi/webhooks-api-60","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-webhook-logs","content":"A response example:"},"839":{"id":"/tonapi/webhooks-api-61","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-webhook-logs","content":"`event_type` is one of `account_tx`, `msg_opcode`, `new_contract`, `mempool_msg` or `suspended`."},"840":{"id":"/tonapi/webhooks-api-62","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-usage-statistics","content":"GET https://rt.tonapi.io/usage-stats - the method returns usage statistics for the current billing period."},"841":{"id":"/tonapi/webhooks-api-63","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-usage-statistics","content":"A response example:"},"842":{"id":"/tonapi/webhooks-api-64","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#subscribe-to-account-transactions","content":"POST https://rt.tonapi.io/webhooks/{webhook_id}/account-tx/subscribe - the method takes in a list of account IDs to subscribe to. When a new transaction happens on any of the accounts,\nTONAPI sends a POST request to the webhook URL."},"843":{"id":"/tonapi/webhooks-api-65","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#subscribe-to-account-transactions","content":"A request body:"},"844":{"id":"/tonapi/webhooks-api-66","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#bulk-subscribe-to-account-transactions","content":"POST https://rt.tonapi.io/webhooks/{webhook_id}/account-tx/bulk-subscribe - the method takes in a file with account IDs, one per line,\nuploaded as the `accounts` field of a `multipart/form-data` request."},"845":{"id":"/tonapi/webhooks-api-67","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#bulk-subscribe-to-account-transactions","content":"For example:"},"846":{"id":"/tonapi/webhooks-api-68","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#unsubscribe-from-account-transactions","content":"POST https://rt.tonapi.io/webhooks/{webhook_id}/account-tx/unsubscribe - the method takes in a list of account IDs to unsubscribe from."},"847":{"id":"/tonapi/webhooks-api-69","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#unsubscribe-from-account-transactions","content":"A request body:"},"848":{"id":"/tonapi/webhooks-api-70","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-a-webhooks-subscriptions","content":"GET https://rt.tonapi.io/webhooks/{webhook_id}/account-tx/subscriptions?offset=0&limit=10 - `limit` is from 2 to 1000, 1000 by default."},"849":{"id":"/tonapi/webhooks-api-71","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#get-a-webhooks-subscriptions","content":"A response example:"},"850":{"id":"/tonapi/webhooks-api-72","page_id":"/tonapi/webhooks-api","tags":[],"type":"text","url":"/tonapi/webhooks-api#subscribe-to-events-about-new-contract-deployments","conte