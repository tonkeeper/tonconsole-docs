api/rest-api/emulation-8","page_id":"/tonapi/rest-api/emulation","tags":[],"type":"text","url":"/tonapi/rest-api/emulation#implementation-example","content":"A detailed example of gasless transaction implementation is available in the Cookbook."},"515":{"id":"/tonapi/rest-api/emulation-9","page_id":"/tonapi/rest-api/emulation","tags":[],"type":"text","url":"/tonapi/rest-api/emulation#operations","content":"`decodeMessage` — Decode a given message. Only external incoming messages can be decoded currently."},"516":{"id":"/tonapi/rest-api/emulation-10","page_id":"/tonapi/rest-api/emulation","tags":[],"type":"text","url":"/tonapi/rest-api/emulation#operations","content":"`emulateMessageToAccountEvent` — Emulate sending message to retrieve account-specific events"},"517":{"id":"/tonapi/rest-api/emulation-11","page_id":"/tonapi/rest-api/emulation","tags":[],"type":"text","url":"/tonapi/rest-api/emulation#operations","content":"`emulateMessageToEvent` — Emulate sending message to retrieve general blockchain events"},"518":{"id":"/tonapi/rest-api/emulation-12","page_id":"/tonapi/rest-api/emulation","tags":[],"type":"text","url":"/tonapi/rest-api/emulation#operations","content":"`emulateMessageToTrace` — Emulate sending message to retrieve with a detailed execution trace"},"519":{"id":"/tonapi/rest-api/emulation-13","page_id":"/tonapi/rest-api/emulation","tags":[],"type":"text","url":"/tonapi/rest-api/emulation#operations","content":"`emulateMessageToWallet` — Emulates a wallet message on the current blockchain state and derives its consequences for the signing wallet"},"520":{"id":"/tonapi/rest-api/events","page_id":"/tonapi/rest-api/events","type":"page","content":"Events","breadcrumbs":["Tonconsole","Ton API","REST API"],"tags":[],"url":"/tonapi/rest-api/events"},"521":{"id":"/tonapi/rest-api/events-0","page_id":"/tonapi/rest-api/events","type":"heading","tags":[],"url":"/tonapi/rest-api/events#operations","content":"Operations"},"522":{"id":"/tonapi/rest-api/events-1","page_id":"/tonapi/rest-api/events","tags":[],"type":"text","url":"/tonapi/rest-api/events","content":"**Events** service provides access to high-level actions that occur on the TON blockchain. These actions are derived from traces, which represent a series of transactions caused by a single inbound message. Events are meaningful operations such as Jetton transfers, NFT purchases, and other user interactions. By using the **Events** service, you can retrieve detailed information about user activities on the TON blockchain."},"523":{"id":"/tonapi/rest-api/events-2","page_id":"/tonapi/rest-api/events","tags":[],"type":"text","url":"/tonapi/rest-api/events","content":"Can't be used for building logic, as the structure of events can change at any\ntime."},"524":{"id":"/tonapi/rest-api/events-3","page_id":"/tonapi/rest-api/events","tags":[],"type":"text","url":"/tonapi/rest-api/events","content":"Use it only for displaying information to users."},"525":{"id":"/tonapi/rest-api/events-4","page_id":"/tonapi/rest-api/events","tags":[],"type":"text","url":"/tonapi/rest-api/events#operations","content":"`getEvent` — Get an event either by event ID or a hash of any transaction in a trace. An event is built on top of a trace which is a series of transactions caused by one inbound message. TonAPI looks for known patterns inside the trace and splits the trace into actions, where a single action represents a meaningful high-level operation like a Jetton Transfer or an NFT Purchase. Actions are expected to be shown to users. It is advised not to build any logic on top of actions because actions can be changed at any time."},"526":{"id":"/tonapi/rest-api/events-5","page_id":"/tonapi/rest-api/events","tags":[],"type":"text","url":"/tonapi/rest-api/events#operations","content":"`emulateMessageToEvent` — Emulate sending message to retrieve general blockchain events"},"527":{"id":"/tonapi/rest-api/extra-currency","page_id":"/tonapi/rest-api/extra-currency","type":"page","content":"Extra Currency","breadcrumbs":["Tonconsole","Ton API","REST API"],"tags":[],"url":"/tonapi/rest-api/extra-currency"},"528":{"id":"/tonapi/rest-api/extra-currency-0","page_id":"/tonapi/rest-api/extra-currency","type":"heading","tags":[],"url":"/tonapi/rest-api/extra-currency#operations","content":"Operations"},"529":{"id":"/tonapi/rest-api/extra-currency-1","page_id":"/tonapi/rest-api/extra-currency","tags":[],"type":"text","url":"/tonapi/rest-api/extra-currency","content":"Open in Swagger UI"},"530":{"id":"/tonapi/rest-api/extra-currency-2","page_id":"/tonapi/rest-api/extra-currency","tags":[],"type":"text","url":"/tonapi/rest-api/extra-currency","content":"**Extra Currency in TON** is an additional cryptocurrency similar to tokens but with several key differences in its creation and management. It is a native part of the TON blockchain and is integrated directly into its core configuration."},"531":{"id":"/tonapi/rest-api/extra-currency-3","page_id":"/tonapi/rest-api/extra-currency","tags":[],"type":"text","url":"/tonapi/rest-api/extra-currency","content":"Unlike traditional tokens, which are created and controlled through smart contracts, extra currency is defined at the network configuration level. These tokens are identified by unique 32-bit identifiers and are embedded in every internal message and account balance, ensuring transparent management of their issuance and circulation."},"532":{"id":"/tonapi/rest-api/extra-currency-4","page_id":"/tonapi/rest-api/extra-currency","tags":[],"type":"text","url":"/tonapi/rest-api/extra-currency","content":"For more information, please refer to the official documentation."},"533":{"id":"/tonapi/rest-api/extra-currency-5","page_id":"/tonapi/rest-api/extra-currency","tags":[],"type":"text","url":"/tonapi/rest-api/extra-currency#operations","content":"`getExtraCurrencyInfo` — Get extra currency info by id"},"534":{"id":"/tonapi/rest-api/gasless","page_id":"/tonapi/rest-api/gasless","type":"page","content":"Gasless","breadcrumbs":["Tonconsole","Ton API","REST API"],"tags":[],"url":"/tonapi/rest-api/gasless"},"535":{"id":"/tonapi/rest-api/gasless-0","page_id":"/tonapi/rest-api/gasless","type":"heading","tags":[],"url":"/tonapi/rest-api/gasless#architecture","content":"Architecture"},"536":{"id":"/tonapi/rest-api/gasless-1","page_id":"/tonapi/rest-api/gasless","type":"heading","tags":[],"url":"/tonapi/rest-api/gasless#process-for-executing","content":"Process for Executing"},"537":{"id":"/tonapi/rest-api/gasless-2","page_id":"/tonapi/rest-api/gasless","type":"heading","tags":[],"url":"/tonapi/rest-api/gasless#gasless-transactions","content":"Gasless transactions"},"538":{"id":"/tonapi/rest-api/gasless-3","page_id":"/tonapi/rest-api/gasless","type":"heading","tags":[],"url":"/tonapi/rest-api/gasless#implementation-example","content":"Implementation Example"},"539":{"id":"/tonapi/rest-api/gasless-4","page_id":"/tonapi/rest-api/gasless","type":"heading","tags":[],"url":"/tonapi/rest-api/gasless#operations","content":"Operations"},"540":{"id":"/tonapi/rest-api/gasless-5","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless","content":"Open in Swagger UI"},"541":{"id":"/tonapi/rest-api/gasless-6","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless","content":"**Gasless transactions** on the TON platform enable users to send transactions without paying gas fees directly from their wallets. This is achieved using **Signed Internal Messages** sent through a **gas proxy contract**, which covers the transaction fees on behalf of the user. This approach simplifies blockchain interactions, making it easier for users who may not have GRAM in their wallets."},"542":{"id":"/tonapi/rest-api/gasless-7","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless","content":"This service only works with W5 wallets"},"543":{"id":"/tonapi/rest-api/gasless-8","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#architecture","content":"Gasless transactions leverage **Signed Internal Messages**. These messages are signed by the user but routed through a smart contract that pays the fees using a **gas proxy**. This eliminates the need for users to hold GRAM for transaction fees."},"544":{"id":"/tonapi/rest-api/gasless-9","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#architecture","content":"**TONAPI** plays a critical role by simulating transaction execution to accurately estimate fees and sending the transaction to multiple validators to increase the chances of successful processing. Additionally, **TONAPI** ensures that the user’s wallet and gas proxy contract are in the same shard, minimizing latency and ensuring fast transaction processing."},"545":{"id":"/tonapi/rest-api/gasless-10","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#process-for-executing","content":"**Fetch Configuration:** Request the gasless transaction parameters using `/v2/gasless/config`."},"546":{"id":"/tonapi/rest-api/gasless-11","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#process-for-executing","content":"**Estimate Transaction:** Send a POST request to `/v2/gasless/estimate/{master_id}` to receive a payload for signing."},"547":{"id":"/tonapi/rest-api/gasless-12","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#process-for-executing","content":"**Sign Payload:** Sign the received payload with your private key."},"548":{"id":"/tonapi/rest-api/gasless-13","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#process-for-executing","content":"**Send Transaction:** Submit the signed message via POST to `/v2/gasless/send`."},"549":{"id":"/tonapi/rest-api/gasless-14","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#gasless-transactions","content":"**TONAPI** supports several gasless transaction types referred to as gasless protocols:"},"550":{"id":"/tonapi/rest-api/gasless-15","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#gasless-transactions","content":"| Gasless protocol | Description                                                                                                                                                                                                                                                                                                          |\n| ---------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| gasless          | Gasless Transfer involves two transactions: the primary Jetton transfer and a secondary transfer that covers the gas fees. The secondary transfer (commission) must be paid using a limited set of Jettons (refer to the gaslessConfig method for the complete list), while the primary transfer can use any Jetton. |","table":"table-0"},"551":{"id":"/tonapi/rest-api/gasless-16","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#gasless-transactions","content":"| Gasless protocol | Description                                                                                                                                                                                                                                                                                       |     |\n| ---------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --- |\n| gasless-swap     | Gasless Swap consists of two transactions: the swap itself and an additional Jetton transfer that covers gas fees. Currently, the protocol supports only Stonfi swaps. Ensure that any excess funds from the swap are directed to the TONAPI relayer, as this will reduce the overall commission. |     |","table":"table-0"},"552":{"id":"/tonapi/rest-api/gasless-17","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#gasless-transactions","content":"| Gasless protocol         | Description                                                                                                                                                                                                                                                                                                                                                               |     |\n| ------------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --- |\n| gasless-generic-transfer | Gasless Generic Transfer consists of a primary Jetton transfer that can include any payload, along with a separate transaction to cover the commission. Gasless Swap differs from Gasless Generic Transfer in that our swap emulation is highly reliable. This accuracy allows us to optimize commission fees by adjusting for any excess funds returned to our relayers. |     |","table":"table-0"},"553":{"id":"/tonapi/rest-api/gasless-18","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#gasless-transactions","content":"The commission is always processed as a separate transfer and must be paid using one of the supported Jettons.\nBoth the gaslessSend and gaslessEstimate methods include the protocol used in their responses."},"554":{"id":"/tonapi/rest-api/gasless-19","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#implementation-example","content":"A detailed example of gasless transaction implementation is available in the Cookbook, showcasing the approach across multiple programming languages."},"555":{"id":"/tonapi/rest-api/gasless-20","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#operations","content":"`gaslessConfig` — Returns configuration of gasless transfers"},"556":{"id":"/tonapi/rest-api/gasless-21","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#operations","content":"`gaslessEstimate` — Estimates the cost of the given messages and returns a payload to sign"},"557":{"id":"/tonapi/rest-api/gasless-22","page_id":"/tonapi/rest-api/gasless","tags":[],"type":"text","url":"/tonapi/rest-api/gasless#operations","content":"`gaslessSend` — Submits the signed gasless transaction message to the network"},"558":{"id":"/tonapi/rest-api","page_id":"/tonapi/rest-api","type":"page","content":"REST API","breadcrumbs":["Tonconsole","Ton API","REST API"],"tags":[],"url":"/tonapi/rest-api"},"559":{"id":"/tonapi/rest-api-0","page_id":"/tonapi/rest-api","tags":[],"type":"text","url":"/tonapi/rest-api","content":"This section of the documentation covers the **TONAPI** REST API, which provides access to various services for interacting with the TON blockchain. These services allow you to perform operations on accounts, retrieve blockchain data, utilize advanced features like gasless transactions, and more."},"560":{"id":"/tonapi/rest-api-1","page_id":"/tonapi/rest-api","tags":[],"type":"text","url":"/tonapi/rest-api","content":"TO